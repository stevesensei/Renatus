@using Markdig

<section class="admin-markdown-editor" aria-label="@Label">
    <div class="admin-markdown-editor-heading">
        <div>
            <MudText Typo="Typo.subtitle2">@Label</MudText>
            @if (!string.IsNullOrWhiteSpace(Hint))
            {
                <MudText Typo="Typo.caption" Class="renatus-muted">@Hint</MudText>
            }
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Markdown</MudChip>
    </div>
    <div class="admin-markdown-editor-grid">
        <div class="admin-markdown-input">
            <MudTextField T="string"
                          Value="@Value"
                          ValueChanged="@HandleValueChanged"
                          Label="@EditorLabel"
                          Lines="12"
                          MaxLength="@MaxLength"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
        </div>
        <article class="admin-markdown-preview" aria-live="polite" aria-label="@PreviewLabel">
            <MudText Typo="Typo.caption" Class="renatus-muted">@PreviewLabel</MudText>
            @if (string.IsNullOrWhiteSpace(Value))
            {
                <MudText Class="renatus-muted admin-markdown-empty">@EmptyText</MudText>
            }
            else
            {
                <div class="renatus-markdown">@((MarkupString)RenderMarkdown(Value))</div>
            }
        </article>
    </div>
</section>

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Markdown";

    [Parameter]
    public string EditorLabel { get; set; } = "Markdown content";

    [Parameter]
    public string PreviewLabel { get; set; } = "Live preview";

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string EmptyText { get; set; } = "Start writing to see the preview.";

    [Parameter]
    public int MaxLength { get; set; } = 4000;

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .Build();

    private Task HandleValueChanged(string value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }

    private static string RenderMarkdown(string value) => Markdown.ToHtml(value, Pipeline);
}
