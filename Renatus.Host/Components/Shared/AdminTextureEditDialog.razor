<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <img class="admin-texture-preview" src="@Texture.DataUrl" alt="@Texture.Name" />
            <MudTextField @bind-Value="_name" Label='@L["textures.textureName"]' Required="true" />
            <MudTextField @bind-Value="_description" Label='@L["textures.descriptionMarkdown"]' Lines="4" MaxLength="4000" />
            <MudSelect T="TextureSource" @bind-Value="_source" Label='@L["textures.source"]'>
                <MudSelectItem Value="TextureSource.Original">@L["textures.original"]</MudSelectItem>
                <MudSelectItem Value="TextureSource.Repost">@L["textures.repost"]</MudSelectItem>
            </MudSelect>
            @if (Texture.Type == TextureType.Skin)
            {
                <MudSelect T="SkinModel" @bind-Value="_skinModel" Label='@L["textures.skinModel"]'>
                    <MudSelectItem Value="SkinModel.Default">@L["textures.default"]</MudSelectItem>
                    <MudSelectItem Value="SkinModel.Slim">@L["textures.slim"]</MudSelectItem>
                </MudSelect>
            }
            <MudSwitch @bind-Value="_isPublic" Color="Color.Primary" Label='@L["textures.public"]' />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["players.cancel"]</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">@L["players.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _name = string.Empty;
    private string _description = string.Empty;
    private TextureSource _source;
    private SkinModel _skinModel;
    private bool _isPublic;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminTextureDetailDto Texture { get; set; } = default!;

    protected override void OnInitialized()
    {
        _name = Texture.Name;
        _description = Texture.DescriptionMarkdown;
        _source = Texture.Source;
        _skinModel = Texture.SkinModel;
        _isPublic = Texture.IsPublic;
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(new AdminTextureEditResult(_name.Trim(), _description.Trim(), _source, _skinModel, _isPublic)));
    private void Cancel() => MudDialog.Cancel();

    public sealed record AdminTextureEditResult(
        string Name,
        string DescriptionMarkdown,
        TextureSource Source,
        SkinModel SkinModel,
        bool IsPublic);
}
