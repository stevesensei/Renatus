<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_password" Label='@L["site.password"]' InputType="InputType.Password" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["players.cancel"]</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">@L["admin.resetPassword"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _password = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_password))
        {
            MudDialog.Close(DialogResult.Ok(_password));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
