<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <div class="admin-detail-summary">
                <MudAvatar Color="Color.Secondary" Size="Size.Large">@Initials</MudAvatar>
                <div>
                    <MudText Typo="Typo.h6">@User.NickName</MudText>
                    <MudText Typo="Typo.body2" Class="renatus-muted">@User.UserName · @User.Email</MudText>
                </div>
            </div>
            <div class="admin-detail-grid">
                <MudText><strong>@L["admin.role"]</strong> @RoleLabel</MudText>
                <MudText><strong>@L["admin.status"]</strong> @StatusLabel</MudText>
                <MudText><strong>@L["admin.players"]</strong> @User.Players.Count</MudText>
                <MudText><strong>@L["admin.textures"]</strong> @User.Textures.Count</MudText>
            </div>
            <MudText Typo="Typo.subtitle1">@L["admin.sessions"] (@User.Sessions.Count)</MudText>
            <MudTable Items="@User.Sessions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["admin.player"]</MudTh>
                    <MudTh>@L["admin.lastUsed"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel='@L["admin.player"]'>@(context.PlayerName ?? L["admin.unassigned"])</MudTd>
                    <MudTd DataLabel='@L["admin.lastUsed"]'>@context.LastUsedAt.ToLocalTime().ToString("g")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["players.cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminUserDetailDto User { get; set; } = default!;

    private string Initials => string.Join(string.Empty, User.NickName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private string RoleLabel => User.Role == UserRole.Admin ? L["admin.adminRole"] : L["admin.playerRole"];
    private string StatusLabel => User.IsDisabled ? L["admin.disabled"] : L["admin.active"];

    private void Close() => MudDialog.Close();
}
