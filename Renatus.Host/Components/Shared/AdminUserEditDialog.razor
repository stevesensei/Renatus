<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField Value="@User.UserName" Label='@L["site.username"]' Disabled="true" />
                <MudTextField @bind-Value="_nickname" Label='@L["site.nickname"]' Required="true" />
                <MudTextField @bind-Value="_email" Label='@L["site.email"]' InputType="InputType.Email" Required="true" />
                <MudTextField @bind-Value="_preferredLanguage" Label='@L["admin.preferredLanguage"]' Required="true" />
                <MudSelect T="UserRole" @bind-Value="_role" Label='@L["admin.role"]'>
                    <MudSelectItem Value="UserRole.Player">@L["admin.playerRole"]</MudSelectItem>
                    <MudSelectItem Value="UserRole.Admin">@L["admin.adminRole"]</MudSelectItem>
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_maxPlayerCount" Label='@L["admin.maxPlayers"]' Min="0" Max="100" />
                <MudSwitch @bind-Value="_isDisabled" Color="Color.Warning" Label='@L["admin.disabled"]' />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["players.cancel"]</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">@L["players.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private string _nickname = string.Empty;
    private string _email = string.Empty;
    private string _preferredLanguage = string.Empty;
    private UserRole _role;
    private int _maxPlayerCount;
    private bool _isDisabled;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminUserListItemDto User { get; set; } = default!;

    protected override void OnInitialized()
    {
        _nickname = User.NickName;
        _email = User.Email;
        _preferredLanguage = User.PreferredLanguage;
        _role = User.Role;
        _maxPlayerCount = User.MaxPlayerCount;
        _isDisabled = User.IsDisabled;
    }

    private async Task Submit()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new AdminUserEditResult(
            _nickname.Trim(), _email.Trim(), _preferredLanguage.Trim(), _role, _maxPlayerCount, _isDisabled)));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed record AdminUserEditResult(
        string NickName,
        string Email,
        string PreferredLanguage,
        UserRole Role,
        int MaxPlayerCount,
        bool IsDisabled);
}
