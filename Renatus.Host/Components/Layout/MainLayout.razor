@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@LayoutClass">
    <MudAppBar Elevation="0" Dense="false" Fixed="true" Class="@AppBarClass">
        <MudButton Href="@(_isAdminPanel ? "/admin" : "/")" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-brand-button" title='@(_isAdminPanel ? L["site.adminPanel"] : L["site.name"])' aria-label='@(_isAdminPanel ? L["site.adminPanel"] : L["site.name"])'>
            @(_isAdminPanel ? L["site.adminPanel"] : L["site.name"])
        </MudButton>
        <MudSpacer />
        <nav class="renatus-top-nav" aria-label='@(_isAdminPanel ? L["nav.admin"] : L["nav.primary"])'>
            @if (_isAdminPanel)
            {
                <MudButton Href="/" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Home" title='@L["nav.home"]' aria-label='@L["nav.home"]'><span class="renatus-button-text">@L["nav.home"]</span></MudButton>
                <MudButton Href="/admin" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Dashboard" title='@L["admin.overview"]' aria-label='@L["admin.overview"]'><span class="renatus-button-text">@L["admin.overview"]</span></MudButton>
                <MudButton Href="/admin/users" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.ManageAccounts" title='@L["admin.users"]' aria-label='@L["admin.users"]'><span class="renatus-button-text">@L["admin.users"]</span></MudButton>
                <MudButton Href="/admin/players" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.People" title='@L["admin.players"]' aria-label='@L["admin.players"]'><span class="renatus-button-text">@L["admin.players"]</span></MudButton>
                <MudButton Href="/admin/textures" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Palette" title='@L["admin.textures"]' aria-label='@L["admin.textures"]'><span class="renatus-button-text">@L["admin.textures"]</span></MudButton>
            }
            else
            {
                <MudButton Href="/" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Home" title='@L["nav.home"]' aria-label='@L["nav.home"]'><span class="renatus-button-text">@L["nav.home"]</span></MudButton>
                <AuthorizeView>
                    <Authorized>
                        <MudButton Href="/dashboard" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Dashboard" title='@L["nav.dashboard"]' aria-label='@L["nav.dashboard"]'><span class="renatus-button-text">@L["nav.dashboard"]</span></MudButton>
                        <MudButton Href="/players" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.People" title='@L["nav.players"]' aria-label='@L["nav.players"]'><span class="renatus-button-text">@L["nav.players"]</span></MudButton>
                        <MudButton Href="/textures" Color="Color.Inherit" Variant="Variant.Text" Class="renatus-nav-button" StartIcon="@Icons.Material.Filled.Palette" title='@L["nav.textures"]' aria-label='@L["nav.textures"]'><span class="renatus-button-text">@L["nav.textures"]</span></MudButton>
                    </Authorized>
                </AuthorizeView>
            }
        </nav>
        <AuthorizeView>
            <Authorized>
                <MudMenu Class="renatus-profile-menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" PopoverClass="renatus-profile-popover" AriaLabel='@L["site.accountMenu"]'>
                    <ActivatorContent Context="menuContext">
                        <MudButton Color="Color.Inherit" Variant="Variant.Text" Class="renatus-profile-trigger" OnClick="@menuContext.ToggleAsync" title='@L["site.accountMenu"]' aria-label='@L["site.accountMenu"]' aria-haspopup="menu">
                            <MudAvatar Color="Color.Secondary" Size="Size.Small">@Initials</MudAvatar>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="renatus-profile-summary">
                            <MudAvatar Color="Color.Secondary" Size="Size.Large">@Initials</MudAvatar>
                            <div class="renatus-profile-copy">
                                <MudText Typo="Typo.subtitle1" Class="renatus-profile-name">@DisplayName</MudText>
                                <MudText Typo="Typo.caption" Class="renatus-profile-role">@(_isAdmin ? L["site.administrator"] : L["site.member"])</MudText>
                            </div>
                        </div>
                        <MudDivider Class="renatus-profile-divider" />
                        <div class="renatus-profile-details">
                            <div class="renatus-profile-detail">
                                <MudText Typo="Typo.caption" Class="renatus-profile-label">@L["site.username"]</MudText>
                                <MudText Typo="Typo.body2" Class="renatus-profile-value">@_userName</MudText>
                            </div>
                            <div class="renatus-profile-detail">
                                <MudText Typo="Typo.caption" Class="renatus-profile-label">@L["site.nickname"]</MudText>
                                <MudText Typo="Typo.body2" Class="renatus-profile-value">@DisplayName</MudText>
                            </div>
                        </div>
                        <MudDivider Class="renatus-profile-divider" />
                        @if (_isAdmin)
                        {
                            <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["site.adminPanel"]</MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@SignOut">@L["site.logout"]</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Color="Color.Inherit" Variant="Variant.Text" Class="renatus-account-button" StartIcon="@Icons.Material.Filled.Login" Href="/login" title='@L["site.login"]' aria-label='@L["site.login"]'><span class="renatus-button-text">@L["site.login"]</span></MudButton>
                <MudButton Color="@(_isLoginPage ? Color.Inherit : Color.Primary)" Variant="Variant.Filled" Class="renatus-account-button" StartIcon="@Icons.Material.Filled.PersonAdd" Href="/login?mode=register" title='@L["site.register"]' aria-label='@L["site.register"]'><span class="renatus-button-text">@L["site.register"]</span></MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent Class="@MainContentClass">
        @if (_usesContainedContent)
        {
            <MudContainer MaxWidth="MaxWidth.Large" Class="renatus-content-container">
                @Body
            </MudContainer>
        }
        else
        {
            @Body
        }
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    @L["errors.unhandled"]
    <a href="" class="reload">@L["shell.reload"]</a>
    <button type="button" class="dismiss" aria-label='@L["shell.dismiss"]'>×</button>
</div>

@code {
    private bool _isDarkMode;
    private bool _isLoginPage;
    private bool _isHomePage = true;
    private bool _isAdminPanel;
    private bool _usesContainedContent;
    private string? _userName;
    private string? _nickname;
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#5B4BE7",
            Secondary = "#00A6A6",
            Tertiary = "#F59E0B",
            AppbarBackground = "#5B4BE7",
            Background = "#F4F6F8",
            Surface = "#FFFFFF",
            TextPrimary = "#172033",
            TextSecondary = "#667085",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
        },
    };

    protected override async Task OnInitializedAsync()
    {
        UpdateRouteState();
        Navigation.LocationChanged += HandleLocationChanged;

        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            _userName = state.User.Identity?.Name;
            _nickname = state.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
            _isAdmin = state.User.IsInRole(nameof(UserRole.Admin));
            UpdateRouteState();
        }
    }

    private string DisplayName => string.IsNullOrWhiteSpace(_nickname) ? _userName ?? L["site.name"] : _nickname;

    private string Initials => string.Join(
        string.Empty,
        DisplayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]))
        .ToUpperInvariant();

    private void SignOut() => Navigation.NavigateTo("/account/signout", forceLoad: true);

    private string LayoutClass => _isLoginPage
        ? "renatus-layout renatus-layout-auth"
        : _isHomePage
            ? "renatus-layout renatus-layout-home"
            : "renatus-layout renatus-layout-app";

    private string AppBarClass => _isLoginPage
        ? "renatus-appbar renatus-appbar-transparent"
        : _isHomePage
            ? "renatus-appbar renatus-appbar-home"
            : "renatus-appbar renatus-appbar-glass";

    private string MainContentClass => _usesContainedContent
        ? "renatus-main-content renatus-main-contained"
        : "renatus-main-content renatus-main-full";

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateRouteState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateRouteState()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        _isLoginPage = path.Equals("/login", StringComparison.OrdinalIgnoreCase);
        _isHomePage = path.Equals("/", StringComparison.OrdinalIgnoreCase);
        _isAdminPanel = _isAdmin && path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);
        _usesContainedContent = !_isLoginPage && !_isHomePage;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
