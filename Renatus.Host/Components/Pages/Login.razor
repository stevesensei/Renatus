@page "/login"
@attribute [AllowAnonymous]
@using System.Security.Cryptography
@using System.Text

<PageTitle>@(_registerMode ? L["site.register"] : L["site.login"])</PageTitle>

<section class="renatus-auth-page" aria-labelledby="auth-title">
    <div class="renatus-auth-shell renatus-surface-enter">
        <div class="renatus-announcement">
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["site.announcement"]</MudText>
            <MudText Typo="Typo.h3" Class="renatus-announcement-title">@(_announcement?.Title ?? L["site.welcome"])</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted">@(_announcement?.Body ?? L["site.signInToContinue"])</MudText>
            <MudDivider Class="renatus-announcement-divider" />
            <MudStack Spacing="2" Class="renatus-announcement-list">
                <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" /> @L["site.secureAuth"]</MudText>
                <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" /> @L["site.playerManagement"]</MudText>
                <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Brush" Size="Size.Small" /> @L["site.textureManagement"]</MudText>
            </MudStack>
        </div>
        <div class="renatus-auth-form">
            <MudText Typo="Typo.h3" id="auth-title">@(_registerMode ? L["site.createAccount"] : L["site.welcomeBack"])</MudText>
            <MudText Typo="Typo.body2" Class="renatus-muted mb-4">@(_registerMode ? L["site.joinCommunity"] : L["site.useAccountToContinue"])</MudText>

            <MudTabs Elevation="0" Rounded="true" Centered="true" ActivePanelIndex="@ActivePanelIndex" ActivePanelIndexChanged="SetModeFromTab" Class="renatus-auth-tabs">
                <MudTabPanel Text='@L["site.login"]' />
                <MudTabPanel Text='@L["site.register"]' />
            </MudTabs>

            @if (_registerMode)
            {
                <EditForm Model="_registerForm" OnValidSubmit="SubmitRegister">
                    <LocalizedDataAnnotationsValidator />
                    <MudTextField @bind-Value="_registerForm.Username" Label='@L["site.username"]' For="@(() => _registerForm.Username)" Required="true" />
                    <MudTextField @bind-Value="_registerForm.Email" Label='@L["site.email"]' InputType="InputType.Email" For="@(() => _registerForm.Email)" Required="true" Class="mt-3" />
                    <MudTextField @bind-Value="_registerForm.NickName" Label='@L["site.nickname"]' For="@(() => _registerForm.NickName)" Class="mt-3" />
                    <MudTextField @bind-Value="_registerForm.Password" Label='@L["site.password"]' InputType="InputType.Password" For="@(() => _registerForm.Password)" Required="true" Class="mt-3" />
                    <ValidationSummary />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_submitting" Class="mt-4">
                        @(_submitting ? L["site.createAccountProgress"] : L["site.createAccount"])
                    </MudButton>
                </EditForm>
            }
            else
            {
                <EditForm Model="_loginForm" OnValidSubmit="SubmitLogin">
                    <LocalizedDataAnnotationsValidator />
                    <MudTextField @bind-Value="_loginForm.Login" Label='@L["site.usernameOrEmail"]' For="@(() => _loginForm.Login)" Required="true" />
                    <MudTextField @bind-Value="_loginForm.Password" Label='@L["site.password"]' InputType="InputType.Password" For="@(() => _loginForm.Password)" Required="true" Class="mt-3" />
                    <ValidationSummary />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_submitting" Class="mt-4">
                        @(_submitting ? L["site.signInProgress"] : L["site.signIn"])
                    </MudButton>
                </EditForm>
            }

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4" aria-live="polite">@_errorMessage</MudAlert>
            }
            <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" Class="mt-3 renatus-mode-switch" OnClick="ToggleMode">
                @(_registerMode ? L["site.alreadyHaveAccount"] : L["site.needAccount"])
            </MudButton>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "mode")]
    private string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private readonly LoginForm _loginForm = new();
    private readonly RegisterForm _registerForm = new();
    private SiteAnnouncementDto? _announcement;
    private string? _errorMessage;
    private bool _registerMode;
    private bool _submitting;

    private int ActivePanelIndex => _registerMode ? 1 : 0;

    [Inject]
    private SiteService SiteService { get; set; } = default!;

    [Inject]
    private AuthService AuthService { get; set; } = default!;

    [Inject]
    private PendingAuthStore PendingAuthStore { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _registerMode = string.Equals(Mode, "register", StringComparison.OrdinalIgnoreCase);
        try
        {
            var config = await SiteService.GetConfigAsync(CancellationToken.None);
            _announcement = config.LoginAnnouncement;
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.authLoad"] : exception.Message;
        }
    }

    private void ToggleMode()
    {
        _registerMode = !_registerMode;
        _errorMessage = null;
    }

    private void SetModeFromTab(int index)
    {
        _registerMode = index == 1;
        _errorMessage = null;
    }

    private async Task SubmitLogin()
    {
        await Submit(() => AuthenticateAsync(_loginForm.Login, _loginForm.Password));
    }

    private async Task SubmitRegister()
    {
        await Submit(() => RegisterAsync(_registerForm));
    }

    private async Task<AuthResponse> AuthenticateAsync(string login, string password)
    {
        var sessionKey = await AuthService.CreateSessionKeyAsync(CancellationToken.None);
        var encryptedPassword = EncryptPassword(sessionKey.PublicKey, password);
        return await AuthService.LoginAsync(
            new LoginRequest(sessionKey.SessionKeyId, login, encryptedPassword),
            CancellationToken.None);
    }

    private async Task<AuthResponse> RegisterAsync(RegisterForm form)
    {
        var sessionKey = await AuthService.CreateSessionKeyAsync(CancellationToken.None);
        var encryptedPassword = EncryptPassword(sessionKey.PublicKey, form.Password);
        return await AuthService.RegisterAsync(
            new RegisterRequest(sessionKey.SessionKeyId, form.Username, form.Email, form.NickName, encryptedPassword),
            CancellationToken.None);
    }

    private static string EncryptPassword(string publicKeyPem, string password)
    {
        using var rsa = RSA.Create();
        rsa.ImportFromPem(publicKeyPem);
        var payload = $"{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}.{password}";
        var encrypted = rsa.Encrypt(Encoding.UTF8.GetBytes(payload), RSAEncryptionPadding.OaepSHA256);
        return Convert.ToBase64String(encrypted);
    }

    private async Task Submit(Func<Task<AuthResponse>> action)
    {
        _submitting = true;
        _errorMessage = null;
        try
        {
            var response = await action();
            var key = PendingAuthStore.Stage(response);
            var returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl;
            Navigation.NavigateTo(
                $"/account/signin?key={key}&returnUrl={Uri.EscapeDataString(returnUrl)}",
                forceLoad: true);
        }
        catch (AuthException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.authLoad"] : exception.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
