@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@using Markdig

<PageTitle>@L["textures.title"]</PageTitle>

<MudStack Spacing="4" Class="renatus-dashboard">
    <section class="renatus-page-hero" aria-labelledby="dashboard-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["nav.dashboard"]</MudText>
            <MudText Typo="Typo.h3" id="dashboard-title">@L["textures.title"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted">@L["textures.description"]</MudText>
        </div>
        <MudButton Href="/players" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.People">
            @L["nav.players"]
        </MudButton>
    </section>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="renatus-dashboard-error" aria-live="polite">@_loadError</MudAlert>
    }

    <div class="renatus-dashboard-grid">
        <div class="renatus-metric-grid">
            <MudPaper Class="renatus-metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.title"]</MudText>
                    <MudText Typo="Typo.h5">@_textures.Count</MudText>
                </div>
            </MudPaper>
            <MudPaper Class="renatus-metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Secondary" />
                <div>
                    <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.publicStatus"]</MudText>
                    <MudText Typo="Typo.h5">@_textures.Count(texture => texture.IsPublic)</MudText>
                </div>
            </MudPaper>
            <MudPaper Class="renatus-metric-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Tertiary" />
                <div>
                    <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.upload"]</MudText>
                    <MudText Typo="Typo.h5">@_textures.Count(texture => !texture.IsPublic)</MudText>
                </div>
            </MudPaper>
        </div>

        <MudPaper Class="renatus-panel renatus-announcement-card" Elevation="0">
            <MudStack Spacing="3">
                <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["site.announcement"]</MudText>
                <MudText Typo="Typo.h5" Class="renatus-announcement-title">@(_announcement?.Title ?? L["site.welcome"])</MudText>
                <div class="mud-typography mud-typography-body1 renatus-muted renatus-markdown">
                    @((MarkupString)Markdown.ToHtml(_announcement?.Body ?? L["site.signInToContinue"], MarkdownPipeline))
                </div>
                @if (!string.IsNullOrWhiteSpace(_announcement?.Image))
                {
                    <img class="renatus-announcement-image" src="@_announcement.Image" alt="@(_announcement?.Title ?? L["site.announcement"])" loading="lazy" />
                }
            </MudStack>
        </MudPaper>
    </div>
</MudStack>

@code {
    private readonly List<TextureDto> _textures = [];
    private readonly CancellationTokenSource _cancellation = new();
    private SiteAnnouncementDto? _announcement;
    private string? _loadError;

    [Inject] private TextureService TextureService { get; set; } = default!;
    [Inject] private FrontendUserContext UserContext { get; set; } = default!;
    [Inject] private SiteService SiteService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await UserContext.GetUserIdAsync();
            var response = await TextureService.GetUserTexturesAsync(userId, _cancellation.Token);
            _textures.AddRange(response.Textures);
        }
        catch (TextureException exception)
        {
            _loadError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.textureLoad"] : exception.Message;
        }

        try
        {
            var config = await SiteService.GetConfigAsync(_cancellation.Token);
            _announcement = config.SiteAnnouncement;
        }
        catch (InvalidOperationException)
        {
            // Announcement falls back to default copy; no blocking error.
        }
    }

    public void Dispose() => _cancellation.Cancel();

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .Build();
}
