@page "/textures"
@attribute [AllowAnonymous]
@implements IAsyncDisposable

<PageTitle>@L["textures.libraryTitle"] · @L["site.name"]</PageTitle>

<div class="texture-library-page" @ref="_libraryRoot">
    <section class="texture-library-hero" aria-labelledby="texture-library-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["textures.libraryEyebrow"]</MudText>
            <MudText Typo="Typo.h3" id="texture-library-title" Class="texture-library-title">@L["textures.libraryTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted texture-library-intro">@L["textures.libraryDescription"]</MudText>
        </div>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/textures/upload" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddPhotoAlternate">
                    @L["textures.upload"]
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login?returnUrl=%2Ftextures%2Fupload" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login">
                    @L["textures.loginToUpload"]
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </section>

    <div class="texture-library-summary" aria-live="polite">
        <div>
            <span class="texture-library-summary-label">@L["textures.publicCount"]</span>
            <strong>@(_response?.TotalCount ?? 0)</strong>
        </div>
        <div>
            <span class="texture-library-summary-label">@L["textures.pageLabel"]</span>
            <strong>@PageLabel</strong>
        </div>
        <div class="texture-library-summary-note">
            <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />
            <span>@L["textures.publicOnlyHint"]</span>
        </div>
    </div>

    @if (_loading)
    {
        <MudPaper Class="renatus-panel texture-library-state" Elevation="0">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label='@L["textures.loading"]' />
            <MudText Class="renatus-muted">@L["textures.loading"]</MudText>
        </MudPaper>
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="texture-library-alert" aria-live="assertive">@_loadError</MudAlert>
    }
    else if (_response?.Textures.Count is null or 0)
    {
        <MudPaper Class="renatus-panel texture-library-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.CollectionsBookmark" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">@L["textures.publicEmpty"]</MudText>
            <MudText Class="renatus-muted">@L["textures.publicEmptyDescription"]</MudText>
            <MudButton Href="/textures/upload" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddPhotoAlternate">
                @L["textures.upload"]
            </MudButton>
        </MudPaper>
    }
    else
    {
        <section class="texture-library-grid" aria-label='@L["textures.libraryTitle"]'>
            @foreach (var texture in _response.Textures)
            {
                <a @key="texture.Id" class="texture-library-card" href="@PreviewLink(texture.Id)" aria-label='@($"{texture.Name} · {L["textures.preview"]}")'>
                    <div class="texture-library-media">
                        <img class="texture-library-preview"
                             src="@PreviewUrl(texture.Id)"
                             alt="@texture.Name"
                             loading="lazy"
                             width="300"

                             data-texture-preview="true"
                             data-texture-type="@TextureTypeKey(texture.Type)"
                             data-texture-source="@PreviewUrl(texture.Id)"
                             data-skin-model="@(texture.SkinModel == SkinModel.Slim ? "slim" : "default")" />
                        <span class="texture-library-card-badge">@SourceLabel(texture.Source)</span>
                        <button type="button"
                                class="@($"texture-library-favorite {(_favoriteBusy == texture.Id ? "is-busy" : string.Empty)} {(texture.IsFavorited ? "is-favorited" : string.Empty)}")"
                                @onclick="@(() => ToggleFavoriteAsync(texture))"
                                @onclick:stopPropagation="true"
                                @onclick:preventDefault="true"
                                aria-pressed="@(texture.IsFavorited ? "true" : "false")"
                                aria-label="@(texture.IsFavorited ? L["textures.unfavorite"] : L["textures.favorite"])"
                                title="@(texture.IsFavorited ? L["textures.unfavorite"] : L["textures.favorite"])">
                            <MudIcon Icon="@(texture.IsFavorited ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)" Size="Size.Small" aria-hidden="true" />
                        </button>
                    </div>
                    <div class="texture-library-card-body">
                        <div class="texture-library-card-heading">
                            <MudText Typo="Typo.h6">@texture.Name</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" aria-hidden="true" />
                        </div>
                        <MudText Typo="Typo.body2" Class="renatus-muted">@TextureMetaLabel(texture)</MudText>
                        <div class="texture-library-card-footer">
                            <span>@texture.Uploader</span>
                            <time datetime="@texture.CreatedAt.ToString("O")">@texture.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</time>
                        </div>
                    </div>
                </a>
            }
        </section>

        <nav class="texture-library-pagination" aria-label='@L["textures.pagination"]'>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_page <= 1 || _loading)" OnClick="@(() => LoadPageAsync(_page - 1))" StartIcon="@Icons.Material.Filled.ChevronLeft">
                @L["textures.previous"]
            </MudButton>
            <span aria-current="page">@PageLabel</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_response is null || _page >= _response.TotalPages || _loading)" OnClick="@(() => LoadPageAsync(_page + 1))" EndIcon="@Icons.Material.Filled.ChevronRight">
                @L["textures.next"]
            </MudButton>
        </nav>
    }
</div>

@code {
    private const int PageSize = 12;
    private readonly CancellationTokenSource _cancellation = new();
    private ElementReference _libraryRoot;
    private PublicTexturePageResponse? _response;
    private int _page = 1;
    private bool _loading = true;
    private string? _loadError;
    private Guid? _favoriteBusy;
    private IJSObjectReference? _module;
    private string _publicBaseUrl = "";

    [Inject] private TextureLibraryService TextureService { get; set; } = default!;
    [Inject] private FrontendUserContext UserContext { get; set; } = default!;
    [Inject] private AppConfigurationService ConfigurationService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    private string PageLabel => _response is null || _response.TotalPages == 0
        ? $"1 / 1"
        : $"{_response.Page} / {_response.TotalPages}";

    protected override Task OnInitializedAsync() => LoadPageAsync(_page);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _loadError is not null || _response?.Textures.Count is null or 0)
        {
            return;
        }

        _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/skin3d-interop.js");
        await _module.InvokeVoidAsync("renderLibraryPreviews", _libraryRoot);
    }

    private async Task LoadPageAsync(int page)
    {
        if (page < 1)
        {
            return;
        }

        _loading = true;
        _loadError = null;
        try
        {
            var siteOptions = await ConfigurationService.GetSiteOptionsAsync(_cancellation.Token);
            _publicBaseUrl = AppConfigurationService.NormalizePublicBaseUrl(siteOptions.PublicBaseUrl);
            var userId = await TryGetUserIdAsync();
            _response = await TextureService.GetPublicTexturesAsync(page, PageSize, userId, _cancellation.Token);
            _page = _response.Page;
        }
        catch (TextureException exception)
        {
            _loadError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.textureLoad"] : exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _loadError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.textureLoad"] : exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleFavoriteAsync(PublicTextureDto texture)
    {
        if (_favoriteBusy is not null)
        {
            return;
        }

        Guid userId;
        try
        {
            userId = await UserContext.GetUserIdAsync();
        }
        catch (AuthException)
        {
            NavigateToLogin();
            return;
        }

        _favoriteBusy = texture.Id;
        try
        {
            if (texture.IsFavorited)
            {
                await TextureService.UnfavoriteTextureAsync(userId, texture.Id, _cancellation.Token);
            }
            else
            {
                await TextureService.FavoriteTextureAsync(userId, texture.Id, _cancellation.Token);
            }

            await LoadPageAsync(_page);
        }
        catch (TextureException)
        {
            await LoadPageAsync(_page);
        }
        finally
        {
            _favoriteBusy = null;
        }
    }

    private async Task<Guid?> TryGetUserIdAsync()
    {
        try
        {
            return await UserContext.GetUserIdAsync();
        }
        catch (AuthException)
        {
            return null;
        }
    }

    private void NavigateToLogin()
    {
        var returnUrl = Uri.EscapeDataString($"/textures?page={_page}");
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", replace: true);
    }

    private string PreviewUrl(Guid id) => $"{_publicBaseUrl.TrimEnd('/')}/api/yggdrasil/textures/{id:N}.png";
    private static string PreviewLink(Guid id) => $"/texture/preview?id={id:N}";
    private string TextureMetaLabel(PublicTextureDto texture) => texture.Type == TextureType.Cape
        ? $"{L["textures.cape"]} · {texture.Width} × {texture.Height}"
        : $"{L["textures.skin"]} · {ModelLabel(texture.SkinModel)} · {texture.Width} × {texture.Height}";
    private static string TextureTypeKey(TextureType type) => type == TextureType.Cape ? "cape" : "skin";
    private string ModelLabel(SkinModel model) => model == SkinModel.Slim ? L["textures.slim"] : L["textures.standard"];
    private string SourceLabel(TextureSource source) => source == TextureSource.Repost ? L["textures.repost"] : L["textures.original"];

    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // 浏览器电路已断开，模块会随电路一起释放。
            }
        }
    }
}
