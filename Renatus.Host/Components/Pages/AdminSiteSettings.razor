@page "/admin/site"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>@L["admin.siteSettings"] · @L["site.name"]</PageTitle>

<MudStack Spacing="4" Class="renatus-admin-page">
    <section class="renatus-page-hero" aria-labelledby="admin-site-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["admin.site"]</MudText>
            <MudText Typo="Typo.h3" id="admin-site-title">@L["admin.siteSettings"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted">@L["admin.siteSettingsDescription"]</MudText>
        </div>
        <MudButton Href="/admin/announcements" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Campaign">
            @L["admin.announcementManagement"]
        </MudButton>
    </section>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@_errorMessage</MudAlert>
    }
    else if (_loading)
    {
        <MudPaper Class="renatus-panel renatus-loading-card" Elevation="0">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="renatus-muted">@L["admin.loading"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="renatus-panel admin-form-panel" Elevation="0">
            <div class="renatus-panel-heading">
                <div>
                    <MudText Typo="Typo.h5">@L["admin.siteIdentity"]</MudText>
                    <MudText Typo="Typo.body2" Class="renatus-muted">@L["admin.siteIdentityDescription"]</MudText>
                </div>
            </div>
            <div class="admin-form-grid">
                <MudTextField @bind-Value="_options.Title" Label='@L["admin.siteTitle"]' MaxLength="120" Required="true" />
                <MudTextField @bind-Value="_options.PublicBaseUrl" Label='@L["admin.publicBaseUrl"]' MaxLength="512" Required="true" />
                <MudTextField @bind-Value="_options.HeroImage" Label='@L["admin.heroImage"]' MaxLength="1024" />
                <MudTextField @bind-Value="_options.Description" Label='@L["admin.siteDescription"]' Lines="3" MaxLength="500" Class="admin-form-span-2" />
            </div>
        </MudPaper>

        <MudPaper Class="renatus-panel admin-form-panel" Elevation="0">
            <div class="renatus-panel-heading">
                <div>
                    <MudText Typo="Typo.h5">@L["admin.siteButtons"]</MudText>
                    <MudText Typo="Typo.body2" Class="renatus-muted">@L["admin.siteButtonsDescription"]</MudText>
                </div>
            </div>
            <div class="admin-button-editor-list">
                @for (var index = 0; index < _buttons.Count; index++)
                {
                    var buttonIndex = index;
                    <div class="admin-button-editor">
                        <MudText Typo="Typo.subtitle2">@L["admin.button"] @(buttonIndex + 1)</MudText>
                        <div class="admin-form-grid">
                            <MudTextField @bind-Value="_buttons[buttonIndex].Label" Label='@L["admin.buttonLabel"]' MaxLength="80" />
                            <MudTextField @bind-Value="_buttons[buttonIndex].Url" Label='@L["admin.buttonUrl"]' MaxLength="1024" />
                            <MudTextField @bind-Value="_buttons[buttonIndex].Style" Label='@L["admin.buttonStyle"]' MaxLength="32" />
                            <MudTextField @bind-Value="_buttons[buttonIndex].Target" Label='@L["admin.buttonTarget"]' MaxLength="32" />
                        </div>
                    </div>
                }
            </div>
        </MudPaper>

        <div class="admin-form-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@_saving">
                @(_saving ? L["admin.saving"] : L["admin.save"])
            </MudButton>
        </div>
    }
</MudStack>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private SiteOptions _options = new();
    private List<SiteButtonOptions> _buttons = [];
    private string? _errorMessage;
    private bool _loading = true;
    private bool _saving;

    [Inject] private AppConfigurationService ConfigurationService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _options = await ConfigurationService.GetSiteOptionsAsync(_cancellation.Token);
            _buttons = (_options.Buttons ?? [])
                .Take(3)
                .Select(CloneButton)
                .ToList();
            while (_buttons.Count < 3)
            {
                _buttons.Add(new SiteButtonOptions());
            }
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["admin.loadError"] : exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errorMessage = null;
        try
        {
            _options.Buttons = _buttons;
            await ConfigurationService.UpdateSiteOptionsAsync(_options, _cancellation.Token);
            Snackbar.Add(L["admin.saved"], Severity.Success);
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["admin.saveError"] : exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose() => _cancellation.Cancel();

    private static SiteButtonOptions CloneButton(SiteButtonOptions button) => new()
    {
        Label = button.Label,
        Url = button.Url,
        Style = button.Style,
        Target = button.Target
    };
}
