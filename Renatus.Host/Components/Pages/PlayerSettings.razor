@page "/players/{PlayerId:guid}/settings"
@attribute [Authorize]

<PageTitle>@L["players.editTextures"] · @L["site.name"]</PageTitle>

<MudStack Spacing="4" Class="renatus-player-settings">
    <section class="renatus-page-hero" aria-labelledby="settings-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["nav.players"]</MudText>
            <MudText Typo="Typo.h3" id="settings-title">@L["players.editTextures"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted">@L["players.description"]</MudText>
        </div>
        <MudStack Row="true" Spacing="2" Class="renatus-toolbar-actions">
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" Color="Color.Primary" Href="/players">
                @L["nav.players"]
            </MudButton>
        </MudStack>
    </section>

    @if (_isLoading)
    {
        <MudCard Outlined="true" Class="renatus-panel renatus-loading-card">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Color="Color.Secondary">@L["players.loading"]</MudText>
            </MudStack>
        </MudCard>
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="ClearLoadError" aria-live="polite">
            @_loadError
        </MudAlert>
    }
    else if (_player is not null)
    {
        <div class="player-settings-layout">
            <MudPaper Class="renatus-panel player-settings-textures" Elevation="0" aria-labelledby="textures-heading">
                <div class="player-settings-panel-heading">
                    <MudText Typo="Typo.h5" id="textures-heading">@L["nav.textures"]</MudText>
                </div>

                <section class="player-settings-group" aria-labelledby="skins-heading">
                    <MudText Typo="Typo.subtitle2" id="skins-heading" Class="player-settings-group-title">@L["textures.skin"]</MudText>
                    @if (_skins.Count == 0)
                    {
                        <MudText Class="renatus-muted player-settings-empty">@L["textures.noTextures"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2" Class="player-settings-cards">
                            @foreach (var option in _skins)
                            {
                                <button type="button" class="@($"player-texture-card {(_selectedSkinId == option.Texture.Id ? "is-selected" : string.Empty)}")"
                                        @onclick="@(() => ToggleSkin(option.Texture.Id))"
                                        aria-pressed="@(_selectedSkinId == option.Texture.Id ? "true" : "false")">
                                    <img src="@PreviewUrl(option.Texture.Id)" alt="@option.Texture.Name" class="player-texture-thumb" loading="lazy" />
                                    <span class="player-texture-meta">
                                        <span class="player-texture-name">@option.Texture.Name</span>
                                        <span class="player-texture-sub">@ModelLabel(option.Texture.SkinModel) · @option.Texture.Width × @option.Texture.Height</span>
                                    </span>
                                    <span class="player-texture-badges">
                                        @if (!option.IsOwned)
                                        {
                                            <span class="player-texture-source-badge">@L["textures.favorited"]</span>
                                        }
                                        @if (_selectedSkinId == option.Texture.Id)
                                        {
                                            <span class="player-texture-badge">@L["textures.selected"]</span>
                                        }
                                    </span>
                                </button>
                            }
                        </MudStack>
                    }
                </section>

                <section class="player-settings-group" aria-labelledby="capes-heading">
                    <MudText Typo="Typo.subtitle2" id="capes-heading" Class="player-settings-group-title">@L["textures.cape"]</MudText>
                    @if (_capes.Count == 0)
                    {
                        <MudText Class="renatus-muted player-settings-empty">@L["textures.noTextures"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2" Class="player-settings-cards">
                            @foreach (var option in _capes)
                            {
                                <button type="button" class="@($"player-texture-card {(_selectedCapeId == option.Texture.Id ? "is-selected" : string.Empty)}")"
                                        @onclick="@(() => ToggleCape(option.Texture.Id))"
                                        aria-pressed="@(_selectedCapeId == option.Texture.Id ? "true" : "false")">
                                    <img src="@PreviewUrl(option.Texture.Id)" alt="@option.Texture.Name" class="player-texture-thumb" loading="lazy" />
                                    <span class="player-texture-meta">
                                        <span class="player-texture-name">@option.Texture.Name</span>
                                        <span class="player-texture-sub">@option.Texture.Width × @option.Texture.Height</span>
                                    </span>
                                    <span class="player-texture-badges">
                                        @if (!option.IsOwned)
                                        {
                                            <span class="player-texture-source-badge">@L["textures.favorited"]</span>
                                        }
                                        @if (_selectedCapeId == option.Texture.Id)
                                        {
                                            <span class="player-texture-badge">@L["textures.selected"]</span>
                                        }
                                    </span>
                                </button>
                            }
                        </MudStack>
                    }
                </section>
            </MudPaper>

            <MudPaper Class="renatus-panel player-settings-preview" Elevation="0" aria-labelledby="preview-heading">
                <div class="player-settings-panel-heading">
                    <MudText Typo="Typo.h5" id="preview-heading">@L["textures.preview"]</MudText>
                </div>

                <dl class="player-settings-info">
                    <div><dt>@L["players.name"]</dt><dd>@_player.Name</dd></div>
                    <div><dt>@L["players.optionalGuid"]</dt><dd class="player-settings-mono">@_player.Id.ToString("D")</dd></div>
                </dl>

                <div class="player-settings-preview-grid">
                    <figure class="player-settings-figure">
                        <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.skin"]</MudText>
                        <div class="player-settings-figure-media">
                            <img src="@SkinPreviewUrl" alt="@L["textures.skin"]" />
                        </div>
                        @if (_selectedSkinId is not null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Color="Color.Default"
                                          aria-label='@L["players.cancel"]' Class="player-settings-clear"
                                          OnClick="@(() => _selectedSkinId = null)" />
                        }
                    </figure>
                    <figure class="player-settings-figure">
                        <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.cape"]</MudText>
                        <div class="player-settings-figure-media">
                            @if (_selectedCapeId is not null)
                            {
                                <img src="@PreviewUrl(_selectedCapeId.Value)" alt="@L["textures.cape"]" />
                            }
                            else
                            {
                                <div class="player-settings-figure-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Checkroom" Color="Color.Default" />
                                </div>
                            }
                        </div>
                        @if (_selectedCapeId is not null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" Color="Color.Default"
                                          aria-label='@L["players.cancel"]' Class="player-settings-clear"
                                          OnClick="@(() => _selectedCapeId = null)" />
                        }
                    </figure>
                </div>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="player-settings-model">
                    <MudText Typo="Typo.body2" Class="renatus-muted">@L["textures.skinModel"]</MudText>
                    <MudSelect T="SkinModel" @bind-Value="_skinModel" Dense="true" Style="max-width: 160px">
                        <MudSelectItem Value="SkinModel.Default">@L["textures.default"]</MudSelectItem>
                        <MudSelectItem Value="SkinModel.Slim">@L["textures.slim"]</MudSelectItem>
                    </MudSelect>
                </MudStack>

                @if (_saveError is not null)
                {
                    <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="ClearSaveError" aria-live="polite">
                        @_saveError
                    </MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="player-settings-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="BackAsync" Disabled="@_isSaving">
                        @L["players.cancel"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitAsync" Disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                        }
                        else
                        {
                            @L["players.save"]
                        }
                    </MudButton>
                </MudStack>
            </MudPaper>
        </div>
    }
</MudStack>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private PlayerDto? _player;
    private List<TextureOption> _skins = [];
    private List<TextureOption> _capes = [];
    private Guid? _selectedSkinId;
    private Guid? _selectedCapeId;
    private SkinModel _skinModel = SkinModel.Default;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadError;
    private string? _saveError;
    private string _publicBaseUrl = "";

    [Parameter]
    public Guid PlayerId { get; set; }

    [Inject] private PlayerService PlayerService { get; set; } = default!;
    [Inject] private TextureService TextureService { get; set; } = default!;
    [Inject] private TextureLibraryService TextureLibraryService { get; set; } = default!;
    [Inject] private FrontendUserContext UserContext { get; set; } = default!;
    [Inject] private AppConfigurationService ConfigurationService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string SkinPreviewUrl => _selectedSkinId is { } id
        ? PreviewUrl(id)
        : "/skins/steve.png";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            var siteOptions = await ConfigurationService.GetSiteOptionsAsync(_cancellation.Token);
            _publicBaseUrl = AppConfigurationService.NormalizePublicBaseUrl(siteOptions.PublicBaseUrl);
            var userId = await UserContext.GetUserIdAsync();
            var player = await PlayerService.GetPlayerAsync(userId, PlayerId, _cancellation.Token);
            var owned = await TextureService.GetUserTexturesAsync(userId, _cancellation.Token);
            var favorited = await TextureLibraryService.GetUserFavoriteTexturesAsync(userId, _cancellation.Token);

            var ownedById = owned.Textures.ToDictionary(texture => texture.Id);
            var merged = new List<TextureOption>(owned.Textures.Count + favorited.Textures.Count);
            foreach (var texture in owned.Textures)
            {
                merged.Add(new TextureOption(texture, true));
            }

            foreach (var texture in favorited.Textures)
            {
                if (!ownedById.ContainsKey(texture.Id))
                {
                    merged.Add(new TextureOption(texture, false));
                }
            }

            _player = player;
            _skins = merged.Where(option => option.Texture.Type == TextureType.Skin).ToList();
            _capes = merged.Where(option => option.Texture.Type == TextureType.Cape).ToList();
            _selectedSkinId = player.SkinTextureId;
            _selectedCapeId = player.CapeTextureId;
            _skinModel = player.SkinModel;
        }
        catch (PlayerException exception) when (IsUnauthorized(exception))
        {
            NavigateToLogin();
        }
        catch (PlayerException exception)
        {
            _loadError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.playerLoad"] : exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _loadError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.playerLoad"] : exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleSkin(Guid id) => _selectedSkinId = _selectedSkinId == id ? null : id;
    private void ToggleCape(Guid id) => _selectedCapeId = _selectedCapeId == id ? null : id;

    private async Task SubmitAsync()
    {
        if (_player is null)
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        try
        {
            var userId = await UserContext.GetUserIdAsync();
            await PlayerService.UpdatePlayerTexturesAsync(
                userId,
                _player.Id,
                new UpdatePlayerTexturesRequest(_selectedSkinId, _selectedCapeId, _skinModel),
                _cancellation.Token);
            Snackbar.Add(L["players.updatedFeedback"], Severity.Success);
            Navigation.NavigateTo("/players");
        }
        catch (PlayerException exception) when (IsUnauthorized(exception))
        {
            NavigateToLogin();
        }
        catch (PlayerException exception)
        {
            _saveError = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.playerUpdate"] : exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void BackAsync() => Navigation.NavigateTo("/players");

    private void ClearLoadError() => _loadError = null;
    private void ClearSaveError() => _saveError = null;

    private string PreviewUrl(Guid id) => $"{_publicBaseUrl.TrimEnd('/')}/api/yggdrasil/textures/{id:N}.png";
    private string ModelLabel(SkinModel model) => model == SkinModel.Slim ? L["textures.slim"] : L["textures.standard"];

    private void NavigateToLogin() =>
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"players/{PlayerId}")}", replace: true);

    private static bool IsUnauthorized(PlayerException exception) =>
        exception.StatusCode is StatusCodes.Status401Unauthorized or StatusCodes.Status403Forbidden;

    private sealed record TextureOption(TextureDto Texture, bool IsOwned);

    public async ValueTask DisposeAsync()
    {
        await _cancellation.CancelAsync();
        _cancellation.Dispose();
    }
}
