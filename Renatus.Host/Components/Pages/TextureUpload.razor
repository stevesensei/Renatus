@page "/textures/upload"
@attribute [Authorize]
@implements IAsyncDisposable

@using System.Buffers.Binary

<PageTitle>@L["textures.uploadTitle"] · @L["site.name"]</PageTitle>

<div class="texture-upload-page">
    <section class="texture-upload-hero" aria-labelledby="texture-upload-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["textures.uploadEyebrow"]</MudText>
            <MudText Typo="Typo.h3" id="texture-upload-title" Class="texture-upload-title">@L["textures.uploadTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted texture-upload-intro">@L["textures.uploadDescription"]</MudText>
        </div>
        <MudButton Href="/textures" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CollectionsBookmark">
            @L["textures.backToLibrary"]
        </MudButton>
    </section>

    <div class="texture-upload-grid">
        <MudPaper Class="renatus-panel texture-upload-form-panel" Elevation="0">
            <div class="texture-upload-section-heading">
                <div>
                    <MudText Typo="Typo.h5">@L["textures.detailsTitle"]</MudText>
                    <MudText Typo="Typo.body2" Class="renatus-muted">@L["textures.detailsHint"]</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" aria-hidden="true" />
            </div>

            <div class="texture-upload-form">
                <fieldset class="texture-upload-field-group">
                    <legend class="texture-upload-field-label">@L["textures.type"]</legend>
                    <MudRadioGroup T="TextureType" @bind-Value="_textureType" @bind-Value:after="HandleTextureTypeChangedAsync" Class="texture-upload-radio-group" aria-label='@L["textures.type"]'>
                        <MudRadio T="TextureType" Value="TextureType.Skin" Color="Color.Primary">@L["textures.skin"]</MudRadio>
                        <MudRadio T="TextureType" Value="TextureType.Cape" Color="Color.Primary">@L["textures.cape"]</MudRadio>
                    </MudRadioGroup>
                </fieldset>

                <MudTextField @bind-Value="_name" Label='@L["textures.textureName"]' Required="true" Immediate="true" MaxLength="80" HelperText='@L["textures.textureNameHint"]' />

                @if (_textureType == TextureType.Skin)
                {
                <fieldset class="texture-upload-field-group">
                    <legend class="texture-upload-field-label">@L["textures.skinModel"]</legend>
                    <MudRadioGroup T="SkinModel" @bind-Value="_skinModel" @bind-Value:after="UpdatePreviewAsync" Class="texture-upload-radio-group" aria-label='@L["textures.skinModel"]'>
                        <MudRadio T="SkinModel" Value="SkinModel.Default" Color="Color.Primary">@L["textures.standard"]</MudRadio>
                        <MudRadio T="SkinModel" Value="SkinModel.Slim" Color="Color.Primary">@L["textures.slim"]</MudRadio>
                    </MudRadioGroup>
                </fieldset>
                }

                <fieldset class="texture-upload-field-group">
                    <legend class="texture-upload-field-label">@L["textures.source"]</legend>
                    <MudRadioGroup T="TextureSource" @bind-Value="_source" Class="texture-upload-radio-group" aria-label='@L["textures.source"]'>
                        <MudRadio T="TextureSource" Value="TextureSource.Original" Color="Color.Primary">@L["textures.original"]</MudRadio>
                        <MudRadio T="TextureSource" Value="TextureSource.Repost" Color="Color.Primary">@L["textures.repost"]</MudRadio>
                    </MudRadioGroup>
                </fieldset>

                <MudSwitch @bind-Value="_isPrivate" Color="Color.Primary" Label='@L["textures.private"]' />
                <MudTextField @bind-Value="_description" Label='@L["textures.descriptionMarkdown"]' Lines="6" MaxLength="4000" Counter="4000" Placeholder='@L["textures.descriptionPlaceholder"]' HelperText='@L["textures.descriptionHint"]' />

                <fieldset class="texture-upload-field-group">
                    <legend class="texture-upload-field-label">@L["textures.fileLabel"]</legend>
                    <MudFileUpload T="IBrowserFile" Accept=".png,image/png" MaximumFileCount="1" MaxFileSize="@MaxRawFileSize" OnFilesChanged="HandleFileSelected">
                        <CustomContent>
                            <div class="texture-upload-dropzone">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
                                <MudText Typo="Typo.subtitle1">@L["textures.choosePng"]</MudText>
                                <MudText Typo="Typo.caption" Class="renatus-muted">@L["textures.fileHint"]</MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@context.OpenFilePickerAsync">
                                    @L["textures.browseFiles"]
                                </MudButton>
                            </div>
                        </CustomContent>
                        <SelectedTemplate>
                            @if (context is not null)
                            {
                                <div class="texture-upload-selected-file">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" aria-hidden="true" />
                                    <span>@context.Name · @FormatBytes(context.Size)</span>
                                </div>
                            }
                        </SelectedTemplate>
                    </MudFileUpload>
                </fieldset>

                @if (_validationMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" aria-live="assertive">@_validationMessage</MudAlert>
                }
                @if (_uploadSuccess is not null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" aria-live="polite">@_uploadSuccess</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedBytes is null || string.IsNullOrWhiteSpace(_name) || _validationMessage is not null || _uploading)" OnClick="UploadAsync" StartIcon="@Icons.Material.Filled.Publish">
                    @(_uploading ? L["textures.publishing"] : L["textures.publish"])
                </MudButton>
            </div>
        </MudPaper>

        <MudPaper Class="renatus-panel texture-upload-preview-panel" Elevation="0">
            <div class="texture-upload-section-heading">
                <div>
                    <MudText Typo="Typo.h5">@L["textures.livePreview"]</MudText>
                    <MudText Typo="Typo.body2" Class="renatus-muted">@L["textures.livePreviewHint"]</MudText>
                </div>
                <span class="texture-upload-preview-status"><span></span>@L["textures.previewReady"]</span>
            </div>
            <div class="texture-upload-canvas-shell">
                <div class="texture-upload-canvas-glow" aria-hidden="true"></div>
                <canvas @ref="_canvas" aria-label='@L["textures.livePreview"]'></canvas>
                @if (_selectedFile is null)
                {
                    <div class="texture-upload-demo-note"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />@L["textures.previewDemo"]</div>
                }
            </div>
            <div class="texture-upload-preview-meta">
                <div>
                    <span>@L["textures.textureName"]</span>
                    <strong>@(string.IsNullOrWhiteSpace(_name) ? L["textures.untitled"] : _name)</strong>
                </div>
                <div>
                    <span>@L["textures.type"]</span>
                    <strong>@(_textureType == TextureType.Cape ? L["textures.cape"] : L["textures.skin"])</strong>
                </div>
                @if (_textureType == TextureType.Skin)
                {
                <div>
                    <span>@L["textures.skinModel"]</span>
                    <strong>@(_skinModel == SkinModel.Slim ? L["textures.slim"] : L["textures.standard"])</strong>
                </div>
                }
            </div>
        </MudPaper>
    </div>
</div>

@code {
    private const long MaxRawFileSize = 2 * 1024 * 1024;
    private static readonly byte[] PngSignature = [137, 80, 78, 71, 13, 10, 26, 10];
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IBrowserFile? _selectedFile;
    private byte[]? _selectedBytes;
    private string _previewDataUrl = "/skins/steve.png";
    private string _name = string.Empty;
    private TextureType _textureType = TextureType.Skin;
    private SkinModel _skinModel = SkinModel.Default;
    private TextureSource _source = TextureSource.Original;
    private string _description = string.Empty;
    private bool _isPrivate;
    private bool _uploading;
    private bool _viewerCreated;
    private string? _validationMessage;
    private string? _uploadSuccess;

    [Inject] private TextureService TextureService { get; set; } = default!;
    [Inject] private FrontendUserContext UserContext { get; set; } = default!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/skin3d-interop.js");
        }

        await EnsurePreviewAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.GetMultipleFiles(1).SingleOrDefault();
        _selectedBytes = null;
        _validationMessage = null;
        _uploadSuccess = null;
        if (_selectedFile is null)
        {
            return;
        }

        try
        {
            _selectedBytes = await ReadFileAsync(_selectedFile);
            var dimensions = ReadPngDimensions(_selectedBytes);
            if (!IsAllowedTextureSize(dimensions.Width, dimensions.Height))
            {
                _validationMessage = _textureType == TextureType.Cape
                    ? L["textures.invalidCapeSize"]
                    : L["textures.invalidSkinSize"];
                _selectedFile = null;
                _selectedBytes = null;
                _previewDataUrl = "/skins/steve.png";
                return;
            }

            _previewDataUrl = $"data:image/png;base64,{Convert.ToBase64String(_selectedBytes)}";
            await UpdatePreviewAsync();
        }
        catch (InvalidDataException)
        {
            _selectedFile = null;
            _selectedBytes = null;
            _previewDataUrl = "/skins/steve.png";
            _validationMessage = L["textures.invalidPng"];
            await UpdatePreviewAsync();
        }
    }

    private async Task UploadAsync()
    {
        if (_selectedBytes is null || string.IsNullOrWhiteSpace(_name) || _validationMessage is not null)
        {
            return;
        }

        _uploading = true;
        _uploadSuccess = null;
        try
        {
            var request = new UploadTextureRequest(
                _textureType,
                $"data:image/png;base64,{Convert.ToBase64String(_selectedBytes)}",
                !_isPrivate,
                _skinModel,
                _name,
                _source,
                _description);
            await TextureService.UploadTextureAsync(await UserContext.GetUserIdAsync(), request, CancellationToken.None);
            _uploadSuccess = L["textures.publishSuccess"];
            _selectedFile = null;
            _selectedBytes = null;
            _previewDataUrl = "/skins/steve.png";
            await UpdatePreviewAsync();
        }
        catch (TextureException exception)
        {
            _validationMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.upload"] : exception.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task UpdatePreviewAsync()
    {
        if (_module is null)
        {
            return;
        }

        await EnsurePreviewAsync();
        if (_textureType == TextureType.Skin)
        {
            await _module.InvokeVoidAsync("setSkin", _canvas, _previewDataUrl, _skinModel == SkinModel.Slim ? "slim" : "default");
            await _module.InvokeVoidAsync("setCape", _canvas, null);
            return;
        }

        await _module.InvokeVoidAsync("setSkin", _canvas, "/skins/steve.png", "default");
        await _module.InvokeVoidAsync("setCape", _canvas, _selectedFile is null ? null : _previewDataUrl);
    }

    private async Task HandleTextureTypeChangedAsync()
    {
        _validationMessage = null;
        _uploadSuccess = null;
        if (_selectedBytes is not null)
        {
            var dimensions = ReadPngDimensions(_selectedBytes);
            if (!IsAllowedTextureSize(dimensions.Width, dimensions.Height))
            {
                _selectedFile = null;
                _selectedBytes = null;
                _previewDataUrl = "/skins/steve.png";
                _validationMessage = _textureType == TextureType.Cape
                    ? L["textures.invalidCapeSize"]
                    : L["textures.invalidSkinSize"];
            }
        }

        await UpdatePreviewAsync();
    }

    private async Task EnsurePreviewAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!_viewerCreated)
        {
            await _module.InvokeVoidAsync("createViewer", _canvas, "/skins/steve.png", "default");
            _viewerCreated = true;
        }
    }

    private async Task<byte[]> ReadFileAsync(IBrowserFile file)
    {
        if (file.Size > MaxRawFileSize || !file.Name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || !string.Equals(file.ContentType, "image/png", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidDataException();
        }

        await using var stream = file.OpenReadStream(MaxRawFileSize);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return memory.ToArray();
    }

    private static (int Width, int Height) ReadPngDimensions(byte[] bytes)
    {
        if (bytes.Length < 24 || !bytes.AsSpan(0, PngSignature.Length).SequenceEqual(PngSignature) || !bytes.AsSpan(12, 4).SequenceEqual("IHDR"u8))
        {
            throw new InvalidDataException();
        }

        var width = BinaryPrimitives.ReadInt32BigEndian(bytes.AsSpan(16, 4));
        var height = BinaryPrimitives.ReadInt32BigEndian(bytes.AsSpan(20, 4));
        return width > 0 && height > 0 ? (width, height) : throw new InvalidDataException();
    }

    private bool IsAllowedTextureSize(int width, int height)
    {
        if (_textureType == TextureType.Cape)
        {
            var capeWidthMultiple = width / 64;
            return capeWidthMultiple > 0 && width % 64 == 0 && height == 32 * capeWidthMultiple;
        }

        var widthMultiple = width / 64;
        return widthMultiple > 0 && width % 64 == 0 && (height == 32 * widthMultiple || height == 64 * widthMultiple);
    }

    private static string FormatBytes(long bytes) => $"{bytes / 1024d:N1} KiB";

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (_viewerCreated)
            {
                await _module.InvokeVoidAsync("disposeViewer", _canvas);
            }
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
