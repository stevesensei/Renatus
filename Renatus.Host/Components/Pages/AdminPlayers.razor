@page "/admin/players"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>@L["admin.players"] · @L["site.name"]</PageTitle>

<MudStack Spacing="4" Class="renatus-admin-page">
    <section class="renatus-page-hero" aria-labelledby="admin-players-title">
        <div><MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["admin.eyebrow"]</MudText><MudText Typo="Typo.h3" id="admin-players-title">@L["admin.players"]</MudText><MudText Typo="Typo.body1" Class="renatus-muted">@L["admin.playersDescription"]</MudText></div>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshAsync" Disabled="@_loading">@L["admin.refresh"]</MudButton>
    </section>

    <MudPaper Class="renatus-panel" Elevation="0">
        <div class="admin-filter-grid">
            <MudTextField @bind-Value="_search" Label='@L["admin.searchPlayers"]' Clearable="true" />
            <MudTextField @bind-Value="_ownerId" Label='@L["admin.ownerId"]' Clearable="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">@L["admin.search"]</MudButton>
        </div>
    </MudPaper>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@_errorMessage</MudAlert>
    }
    else if (_loading)
    {
        <MudPaper Class="renatus-panel renatus-loading-card" Elevation="0"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><MudText Class="renatus-muted">@L["admin.loading"]</MudText></MudPaper>
    }
    else
    {
        <MudPaper Class="renatus-panel admin-table-panel" Elevation="0">
            <MudTable Items="@(_response?.Items ?? [])" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent><MudTh>@L["admin.player"]</MudTh><MudTh>@L["admin.owner"]</MudTh><MudTh>@L["textures.skinModel"]</MudTh><MudTh>@L["admin.updated"]</MudTh><MudTh>@L["admin.actions"]</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel='@L["admin.player"]'><strong>@context.Name</strong><br /><span class="renatus-muted">@context.Id.ToString("D")</span></MudTd>
                    <MudTd DataLabel='@L["admin.owner"]'>@context.UserName</MudTd>
                    <MudTd DataLabel='@L["textures.skinModel"]'>@ModelLabel(context.SkinModel)</MudTd>
                    <MudTd DataLabel='@L["admin.updated"]'>@context.UpdatedAt.ToLocalTime().ToString("d")</MudTd>
                    <MudTd DataLabel='@L["admin.actions"]'><div class="admin-row-actions"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label='@L["admin.edit"]' OnClick="@(() => EditAsync(context))" /><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label='@L["admin.delete"]' OnClick="@(() => DeleteAsync(context))" /></div></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="renatus-muted">@L["admin.noPlayers"]</MudText></NoRecordsContent>
            </MudTable>
            <div class="admin-pagination"><MudButton Variant="Variant.Outlined" Disabled="@(_response is null || _response.Page <= 1 || _loading)" OnClick="@(() => LoadAsync(_response!.Page - 1))">@L["admin.previous"]</MudButton><span>@PageLabel</span><MudButton Variant="Variant.Outlined" Disabled="@(_response is null || _response.Page >= _response.TotalPages || _loading)" OnClick="@(() => LoadAsync(_response!.Page + 1))">@L["admin.next"]</MudButton></div>
        </MudPaper>
    }
</MudStack>

@code {
    private const int PageSize = 20;
    private readonly CancellationTokenSource _cancellation = new();
    private AdminPageDto<AdminPlayerListItemDto>? _response;
    private string _search = string.Empty;
    private string _ownerId = string.Empty;
    private bool _loading = true;
    private string? _errorMessage;

    [Inject] private PlayerService PlayerService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string PageLabel => _response is null || _response.TotalPages == 0 ? "1 / 1" : $"{_response.Page} / {_response.TotalPages}";
    private Guid? OwnerId => Guid.TryParse(_ownerId.Trim(), out var id) ? id : null;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private Task SearchAsync()
    {
        if (!string.IsNullOrWhiteSpace(_ownerId) && OwnerId is null)
        {
            _errorMessage = L["admin.invalidOwnerId"];
            return Task.CompletedTask;
        }

        return LoadAsync(1);
    }

    private Task RefreshAsync() => LoadAsync(_response?.Page ?? 1);

    private async Task LoadAsync(int page = 1)
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _response = await PlayerService.ListPlayersAsync(page, PageSize, OwnerId, _search, _cancellation.Token);
        }
        catch (PlayerException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["admin.loadError"] : exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EditAsync(AdminPlayerListItemDto player)
    {
        try
        {
            var detail = await PlayerService.GetPlayerDetailAsync(player.Id, _cancellation.Token);
            var dialog = await DialogService.ShowAsync<AdminPlayerEditDialog>(L["admin.editPlayer"], new DialogParameters { ["Player"] = detail }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not AdminPlayerEditDialog.AdminPlayerEditResult edit)
            {
                return;
            }

            await PlayerService.UpdatePlayerAsync(player.Id, new AdminUpdatePlayerRequest(edit.Name, edit.SkinModel, edit.SkinTextureId, edit.CapeTextureId, edit.UserId, edit.ClearSkinTexture, edit.ClearCapeTexture), _cancellation.Token);
            Snackbar.Add(L["admin.saved"], Severity.Success);
            await LoadAsync(_response?.Page ?? 1);
        }
        catch (PlayerException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task DeleteAsync(AdminPlayerListItemDto player)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(L["admin.deletePlayer"], L["admin.deletePlayerPrompt"], yesText: L["admin.delete"], cancelText: L["players.cancel"], options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await PlayerService.DeletePlayerAdminAsync(player.Id, _cancellation.Token);
            Snackbar.Add(L["admin.deleted"], Severity.Success);
            await LoadAsync(_response?.Page ?? 1);
        }
        catch (PlayerException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private string ModelLabel(SkinModel model) => model == SkinModel.Slim ? L["textures.slim"] : L["textures.standard"];
    public void Dispose() => _cancellation.Cancel();
}
