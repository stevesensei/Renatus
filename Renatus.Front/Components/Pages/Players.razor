@page "/players"
@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>@L["players.title"]</PageTitle>

<MudStack Spacing="4" Class="renatus-players">
    <section class="renatus-page-hero" aria-labelledby="players-title">
        <div>
            <MudText Typo="Typo.overline" Class="renatus-eyebrow">@L["nav.players"]</MudText>
            <MudText Typo="Typo.h3" id="players-title">@L["players.title"]</MudText>
            <MudText Typo="Typo.body1" Class="renatus-muted">@L["players.description"]</MudText>
        </div>
        <MudStack Row="true" Spacing="2" Class="renatus-toolbar-actions">
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadPlayersAsync" Disabled="@_isBusy">
                @L["players.refresh"]
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="OpenCreateDialogAsync" Disabled="@(_isBusy || !CanCreate)">
                 @L["players.create"]
            </MudButton>
        </MudStack>
    </section>

    <div class="renatus-metric-grid">
        <MudPaper Class="renatus-metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.caption" Class="renatus-muted">@L["nav.players"]</MudText>
                <MudText Typo="Typo.h5">@_players.Count / @_maxPlayerCount</MudText>
            </div>
        </MudPaper>
        <MudPaper Class="renatus-metric-card" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Secondary" />
            <div>
                <MudText Typo="Typo.caption" Class="renatus-muted">@L["players.create"]</MudText>
                <MudText Typo="Typo.h5">@(CanCreate ? L["site.ready"] : L["players.full"])</MudText>
            </div>
        </MudPaper>
    </div>

    @if (_isLoading)
    {
        <MudCard Outlined="true" Class="renatus-panel renatus-loading-card">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Color="Color.Secondary">@L["players.loading"]</MudText>
            </MudStack>
        </MudCard>
    }
    else if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="ClearError" aria-live="polite">
            @_errorMessage
        </MudAlert>
    }
    else if (_players.Count == 0)
    {
        <MudCard Outlined="true" Class="renatus-panel">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@L["players.empty"]</MudText>
                <MudText Class="renatus-muted">@L["players.emptyDescription"]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenCreateDialogAsync">
                    @L["players.create"]
                </MudButton>
            </MudStack>
        </MudCard>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="renatus-panel-heading">
            <MudText Typo="Typo.h5">@L["nav.players"]</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_players.Count / @_maxPlayerCount</MudChip>
        </MudStack>
        <MudGrid Spacing="3">
            @foreach (var player in _players)
            {
                <MudItem xs="12" sm="6" md="4" @key="player.Id">
                    <MudCard Outlined="true" Class="renatus-player-card h-100">
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.h6" Class="renatus-player-name">@player.Name</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@SkinModelLabel(player.SkinModel)</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="renatus-muted">
                                    @L["players.created"]: @player.CreatedAt.ToLocalTime().ToString("d")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="renatus-muted">
                                    @L["players.updated"]: @player.UpdatedAt.ToLocalTime().ToString("d")
                                </MudText>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => OpenEditDialogAsync(player))">
                            @L["players.editTextures"]
                            </MudButton>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                            aria-label='@L["players.delete"]' OnClick="@(() => DeletePlayerAsync(player))" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private readonly List<PlayerDto> _players = [];
    private CancellationTokenSource _loadCancellation = new();
    private readonly object _loadCancellationGate = new();
    private bool _disposed;
    private bool _isLoading = true;
    private bool _isBusy;
    private int _maxPlayerCount;
    private string? _errorMessage;

    [Inject] private PlayerApi PlayerApi { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool CanCreate => _players.Count < _maxPlayerCount;

    protected override Task OnInitializedAsync() => LoadPlayersAsync();

    private async Task LoadPlayersAsync()
    {
        CancellationTokenSource previousCancellation;
        CancellationTokenSource requestCancellation;
        CancellationToken cancellationToken;
        lock (_loadCancellationGate)
        {
            if (_disposed)
            {
                return;
            }

            previousCancellation = _loadCancellation;
            requestCancellation = new CancellationTokenSource();
            _loadCancellation = requestCancellation;
            cancellationToken = requestCancellation.Token;
        }

        previousCancellation.Cancel();
        previousCancellation.Dispose();
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await PlayerApi.ListAsync(cancellationToken);
            _players.Clear();
            _players.AddRange(response.Players);
            _maxPlayerCount = response.MaxPlayerCount;
        }
        catch (ApiException exception) when (IsUnauthorized(exception))
        {
            NavigateToLogin();
        }
        catch (ApiException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? L["errors.playerLoad"] : exception.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_loadCancellation, requestCancellation))
            {
                _isLoading = false;
            }
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<PlayerEditorDialog>(L["players.create"]);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not PlayerEditorDialog.PlayerEditorResult editor)
        {
            return;
        }

        await RunMutationAsync(
            () => PlayerApi.CreateAsync(new CreatePlayerRequest(editor.Name, editor.SkinModel, editor.SkinTextureId, editor.CapeTextureId), _loadCancellation.Token),
            L["errors.playerCreate"],
            L["players.createdFeedback"]);
    }

    private async Task OpenEditDialogAsync(PlayerDto player)
    {
        var parameters = new DialogParameters<PlayerEditorDialog>
        {
            { dialog => dialog.Player, player },
        };
        var dialog = await DialogService.ShowAsync<PlayerEditorDialog>(L["players.editTextures"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not PlayerEditorDialog.PlayerEditorResult editor)
        {
            return;
        }

        await RunMutationAsync(
            () => PlayerApi.UpdateTexturesAsync(
                player.Id,
                new UpdatePlayerTexturesRequest(editor.SkinTextureId, editor.CapeTextureId, editor.SkinModel),
                _loadCancellation.Token),
            L["errors.playerUpdate"],
            L["players.updatedFeedback"]);
    }

    private async Task DeletePlayerAsync(PlayerDto player)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["players.deleteTitle"],
            L["players.deletePrompt"],
            yesText: L["players.delete"],
            cancelText: L["players.cancel"],
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true)
        {
            return;
        }

        await RunMutationAsync(
            () => PlayerApi.DeleteAsync(player.Id, _loadCancellation.Token),
            L["errors.playerDelete"],
            L["players.deletedFeedback"]);
    }

    private async Task RunMutationAsync<T>(Func<Task<T>> operation, string failureFallback, string successMessage)
    {
        var cancellationToken = _loadCancellation.Token;
        _isBusy = true;
        _errorMessage = null;
        try
        {
            await operation();
            Snackbar.Add(successMessage, Severity.Success);
            await LoadPlayersAsync();
        }
        catch (ApiException exception) when (IsUnauthorized(exception))
        {
            NavigateToLogin();
        }
        catch (ApiException exception)
        {
            _errorMessage = string.IsNullOrWhiteSpace(exception.Message) ? failureFallback : exception.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ClearError() => _errorMessage = null;

    private void NavigateToLogin() =>
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("players")}", replace: true);

    private static bool IsUnauthorized(ApiException exception) =>
        exception.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden;

    private string SkinModelLabel(SkinModel model) => model == SkinModel.Slim ? L["textures.slim"] : L["textures.default"];

    public async ValueTask DisposeAsync()
    {
        CancellationTokenSource cancellation;
        lock (_loadCancellationGate)
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            cancellation = _loadCancellation;
        }

        await cancellation.CancelAsync();
        cancellation.Dispose();
    }
}
